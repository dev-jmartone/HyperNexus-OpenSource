# ==============================================================================
# VDI INVENTORY HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and adjust the configuration parameters.

# ------------------------------------------------------------------------------
# CORE SECURITY KEYS (REQUIRED)
# ------------------------------------------------------------------------------
# Flask session cryptographic secret key. Must be a strong, random string.
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# Fernet symmetric encryption key for hypervisor credentials stored in database.
# Generate in Python with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-base64-encoded-32-byte-fernet-key=

# ------------------------------------------------------------------------------
# APPLICATION MODE & PORTS
# ------------------------------------------------------------------------------
# When set to 1, enables simulated extraction and offline mock telemetry (No real infra required).
DEMO_MODE=1

# Host and Port bindings
HOST=0.0.0.0
PORT=5000

# Number of Waitress WSGI worker threads (Production)
THREADS=16

# Force HTTPS cookie security (Set to 1 behind reverse proxy with SSL termination)
FORCE_HTTPS=0

# ------------------------------------------------------------------------------
# ACTIVE DIRECTORY & INFRASTRUCTURE DOMAINS
# ------------------------------------------------------------------------------
# Corporate Active Directory domain
AD_DOMAIN=corp.local

# Default domain for Horizon Connection Server authentication
HORIZON_DEFAULT_DOMAIN=CORP

# External contractor / vendor domain identification rules (JSON format)
# DOMINIOS_EMPRESA_JSON={"PartnerCorp": ["partner.com", "partnercorp.com"]}

# ------------------------------------------------------------------------------
# DATABASE & REDIS
# ------------------------------------------------------------------------------
# Path to SQLite database file (Defaults to data/inventario.db)
INVENTARIO_DB_PATH=data/inventario.db

# Optional Redis connection URL for multi-worker SSE real-time events and KPI caching.
# If omitted or unreachable, gracefully falls back to in-process memory.
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# RETENTION & AUDITING
# ------------------------------------------------------------------------------
# Number of days to retain snapshot history before automated purging
RETENCION_SNAPSHOTS_DIAS=90
